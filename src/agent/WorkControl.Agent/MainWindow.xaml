<Window x:Class="WorkControl.Agent.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WorkControl — тестовый агент" Width="560" MinHeight="480" SizeToContent="Height" ResizeMode="NoResize">
  <StackPanel Margin="24">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Тестовый агент WorkControl" />
    <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Text="Передаёт только состояние активности, исходную длительность простоя и признак длительного отсутствия. Сбор экранов, сайтов и содержимого ввода отсутствует." />
    <TextBlock Text="Адрес API" />
    <TextBox x:Name="ApiUrlBox" Margin="0,4,0,12" Text="http://localhost:5080" />
    <TextBlock Text="Одноразовый код подключения (действует 10 минут)" />
    <TextBox x:Name="EnrollmentCodeBox" Margin="0,4,0,8" />
    <Button Click="EnrollButton_Click" Width="230" MinHeight="32" Padding="8,4" HorizontalAlignment="Left" Content="Подключить этот компьютер" />
    <Separator Margin="0,16" />
    <TextBlock Text="Идентификатор агента" />
    <TextBox x:Name="AgentIdBox" Margin="0,4,0,16" IsReadOnly="True" ToolTip="Назначается сервером после ввода одноразового кода" />
    <Button Click="SendButton_Click" Width="230" MinHeight="32" Padding="8,4" HorizontalAlignment="Left" Content="Отправить контрольное событие" />
    <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" />
  </StackPanel>
</Window>
