{
  "ConnectionStrings": {
    "WorkControl": "Data Source=workcontrol.db"
  },
  "Database": { "Provider": "Sqlite", "AutoMigrate": true },
  "WorkControl": { "Mode": "Local" },
  "Security": {
    "EnrollmentMinutes": 10,
    "AgentCredentialDays": 90
  },
  "Presence": { "OnlineThresholdSeconds": 90 },
  "Telemetry": { "MaximumSignalGapSeconds": 90 },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
